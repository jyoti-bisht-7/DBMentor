PORT=8000
NLP_URL=http://127.0.0.1:8001
NLP_TIMEOUT_MS=300000
DATABASE_URL=postgresql://dbmentor:dbmentor@127.0.0.1:5432/dbmentor
PGSSL=false
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MODEL_BACKEND=transformers
SCHEMA_MODEL=google/flan-t5-small
STORY_MODEL=google/flan-t5-small
SQL_MODEL=gaussalgo/T5-LM-Large-text2sql-spider
SQL_MODEL_TYPE=spider_seq2seq
MODEL_DEVICE=auto
MAX_INPUT_TOKENS=2048
MAX_NEW_TOKENS=512
MIN_FREE_DISK_GB=2
